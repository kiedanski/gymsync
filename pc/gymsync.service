[Unit]
Description=gymsync BLE sync daemon (GymLog watch)
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
# Adjust paths: venv + config location on the target box.
ExecStart=/opt/gymsync/.venv/bin/gymsync --config /etc/gymsync/config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
