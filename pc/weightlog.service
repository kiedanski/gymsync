[Unit]
Description=weightlog BLE sync daemon (WeightLog watch)
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
# Adjust paths: venv + config location on the target box.
ExecStart=/opt/weightlog/.venv/bin/weightlog --config /etc/weightlog/config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
